# Copie este arquivo para .env e ajuste com seus dados.
# O arquivo .env deve ficar em: %AppData%\espanso\match\.env
# (mesma pasta do base.yml, junto com a pasta scripts/)

# Nome do atendente (ex.: "Sou Bruno e vou prosseguir...")
ATENDENTE_NOME=Bruno

# Nome da empresa (ex.: "A COM4 agradece...", modem COM4)
EMPRESA_NOME=COM4

# E-mail de atendimento (ex.: solicitação cPanel)
EMAIL_ATENDIMENTO=atendimento@com4.com.br
